# API
NEXT_PUBLIC_BACKEND_URL=https://aws-api.reparv.in
VITE_BACKEND_URL=https://aws-api.reparv.in

# S3 image CDN base (no trailing slash)
NEXT_PUBLIC_S3_IMAGE_URL=https://reparv-assets.s3.ap-south-1.amazonaws.com
VITE_S3_IMAGE_URL=https://reparv-assets.s3.ap-south-1.amazonaws.com

# Auth / payments (set from your Google Cloud / Razorpay dashboards)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# VITE_RAZORPAY_KEY_ID=

# AI agent (optional)
# NEXT_PUBLIC_AI_AGENT_PUBLIC_KEY=
# VITE_AI_AGENT_PUBLIC_KEY=
