# Copy to `.env.local` for local development.
# Use NEXT_PUBLIC_* keys — Next.js exposes these to the browser.
# Legacy VITE_* names still work as fallbacks (see next.config.mjs).

# Required — API base URL (no trailing slash)
NEXT_PUBLIC_BACKEND_URL=https://aws-api.reparv.in

# Required — S3 image CDN base (no trailing slash)
NEXT_PUBLIC_S3_IMAGE_URL=https://reparv-assets.s3.ap-south-1.amazonaws.com

# Required — Google OAuth (Google Cloud Console → OAuth client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Required — Razorpay public key (client-side checkout only; never put the secret here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional — AI property agent chat widget
# NEXT_PUBLIC_AI_AGENT_PUBLIC_KEY=

